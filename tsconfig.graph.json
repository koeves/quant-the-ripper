{
    "compilerOptions": {
        "target": "ES5",
        "strict": true,
        "noEmitOnError": true,
        "outFile": "device/graph.js",
        "rootDir": "src",
        "module": "none",
        "removeComments": false,
        "ignoreDeprecations": "6.0",
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "lib": [
            "ES5"
        ]
    },
    "include": [
        "src/graph/graph.ts"
    ]
}
